{
  "name": "noscrape",
  "version": "0.1.0",
  "description": "AI-content protection system defending websites against automated scraping by LLM crawlers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./deployments/*": {
      "import": "./dist/deployments/*.js",
      "types": "./dist/deployments/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "noscrape": "./dist/cli.js"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "parse5": "^7.2.0",
    "yaml": "^2.6.0",
    "commander": "^12.1.0",
    "express": "^4.21.0",
    "http-proxy-middleware": "^3.0.0",
    "better-sqlite3": "^11.6.0",
    "jsdom": "^25.0.0",
    "diff": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/diff": "^6.0.0",
    "@types/jsdom": "^21.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
